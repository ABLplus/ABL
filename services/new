def finalise_session(session, mode: str) -> None:
    """
    Unified finaliser for both PracticeSession and Test.

    mode: "practice" or "test"
    """
    if mode not in ("practice", "test"):
        raise ValueError(f"Unsupported mode: {mode}")

    # 1. Guard: already completed
    if session.status == "completed":
        return

    # 2. Load logs (single query, with useful joins)
    logs = (
    session.questionlog_set
    .select_related("question__topic", "question__subject", "question__olt", "topic")
    .order_by("timestamp")   # ✅ important
    .all()
)

    if not logs:
        # Nothing to do; just mark completed and bail.
        session.status = "completed"
        session.end_time = timezone.now()
        session.save(update_fields=["status", "end_time"])
        return

    # 3. Build all aggregates once in memory
    aggregates = build_aggregates(logs, session, mode=mode)

    # 4. One transaction for all writes
    with transaction.atomic():
        update_session_row(session, aggregates)               # Test / PracticeSession
        if mode == "test":
            update_qas(aggregates)                            # QuestionAttemptSummary (test only)

        update_tas(aggregates)                                # TopicAttemptSummary
        update_topic_olt_summary(aggregates)                  # TopicOLTSummary
        update_topic_status_from_session(aggregates)          # TopicStatus / PMI / TMI
        update_user_daily_stats(aggregates)                   # UserDailyStats
        register_profile_attempts(aggregates)                 # Profile.register_attempt
        register_subscription_attempts(aggregates)            # optional, safe no-op if none


def build_aggregates(logs, session, *, mode: str) -> dict:
    """
    Single-pass aggregation over QuestionLog rows.

    IMPORTANT:
      - logs MUST be ordered by timestamp ASC before calling this (or order here)
      - In TEST mode we also produce per_topic_tokens (rolling-window payload),
        but we DO NOT compute per_topic_tmi here because TMI depends on
        existing TAS.window + new tokens (merge happens in update_tas()).

    Returns a dict used by all writers, shape:

    {
        "mode": "practice" | "test",
        "now": datetime,
        "user": User,
        "session": session,
        "date": date,
        "duration_hours": float,
        "total": { ... },              # session-level counts (incl blind_* for Test)
        "per_question": {...},         # question_id -> stats   (for QAS)
        "per_topic": {...},            # topic_id -> stats      (for TAS, TopicStatus)
        "per_topic_olt": {...},        # (topic_id, olt_id) -> stats (for TopicOLTSummary)
        "per_topic_tokens": {...},     # topic_id -> [tokens]   (TEST only)
    }
    """
    user = session.user
    now = timezone.now()
    start = session.start_time or now
    duration_seconds = max((now - start).total_seconds(), 0)
    duration_hours = duration_seconds / 3600.0

    # Session-level counters
    total_q = 0
    answered_q = 0
    correct_q = 0
    wrong_q = 0
    unattempted_q = 0

    # Keep blind separate for Test model reporting
    blind_q = 0
    blind_wrong = 0  # usually 0, but kept for schema compatibility

    sureshot_q = applied_q = guesswork_q = 0
    sureshot_wrong = applied_wrong = guesswork_wrong = 0

    # Per-question (for QAS, test mode only; computed anyway)
    per_question = defaultdict(lambda: {
        "answered_q": 0,
        "correct_q": 0,
        "wrong_q": 0,
        "sureshot_q": 0,
        "applied_q": 0,
        "guesswork_q": 0,
        "sureshot_wrong": 0,
        "applied_wrong": 0,
        "guesswork_wrong": 0,
        "topic_id": None,
    })

    # Per-topic (for TAS & TopicStatus)
    per_topic = defaultdict(lambda: {
        "answered_q": 0,
        "correct_q": 0,
        "wrong_q": 0,
        "sureshot_q": 0,
        "applied_q": 0,
        "guesswork_q": 0,
        "blind_q": 0,  # blind tracked separately for reporting (still maps to 'na' in tokens)
        "sureshot_wrong": 0,
        "applied_wrong": 0,
        "guesswork_wrong": 0,
        "blind_wrong": 0,  # usually 0
    })

    # Per topic × OLT (for TopicOLTSummary)
    per_topic_olt = defaultdict(lambda: {
        "answered_q": 0,
        "correct_q": 0,
        "wrong_q": 0,
        "sureshot_q": 0,
        "applied_q": 0,
        "guesswork_q": 0,
        "sureshot_wrong": 0,
        "applied_wrong": 0,
        "guesswork_wrong": 0,
    })

    # TEST-only: token payload to merge into TAS rolling window later
    per_topic_tokens = defaultdict(list)

    for log in logs:
        total_q += 1

        # Capture original attempt_type to count blind separately
        atype_raw = (log.attempt_type or "unattempted").lower()

        token = _token_from_log(log)  # blind/unattempted -> "na"

        # topic and olt ids
        topic_id = log.topic_id or (log.question.topic_id if log.question else None)
        olt_id = log.question.olt_id if getattr(log.question, "olt_id", None) else None

        # collect tokens for TEST window (even "na" matters)
        if mode == "test" and topic_id:
            per_topic_tokens[topic_id].append(token)

        # Treat blind as unattempted in mastery window, but track it separately for Test reporting
        if atype_raw == "blind":
            blind_q += 1
            if topic_id:
                per_topic[topic_id]["blind_q"] += 1
            # blind is effectively unattempted for score/mastery
            unattempted_q += 1
            continue

        # Unattempted (non-blind)
        if token == "na":
            unattempted_q += 1
            continue

        # Attempted
        answered_q += 1
        is_correct = token in ("sr", "ar", "gr")
        if is_correct:
            correct_q += 1
        else:
            wrong_q += 1

        # Session-level breakdowns
        if token in ("sr", "sw"):
            sureshot_q += 1
            if token == "sw":
                sureshot_wrong += 1
        elif token in ("ar", "aw"):
            applied_q += 1
            if token == "aw":
                applied_wrong += 1
        elif token in ("gr", "gw"):
            guesswork_q += 1
            if token == "gw":
                guesswork_wrong += 1

        # Per-question
        q_stats = per_question[log.question_id]
        q_stats["answered_q"] += 1
        if is_correct:
            q_stats["correct_q"] += 1
        else:
            q_stats["wrong_q"] += 1

        if token in ("sr", "sw"):
            q_stats["sureshot_q"] += 1
            if token == "sw":
                q_stats["sureshot_wrong"] += 1
        elif token in ("ar", "aw"):
            q_stats["applied_q"] += 1
            if token == "aw":
                q_stats["applied_wrong"] += 1
        elif token in ("gr", "gw"):
            q_stats["guesswork_q"] += 1
            if token == "gw":
                q_stats["guesswork_wrong"] += 1

        if topic_id and q_stats["topic_id"] is None:
            q_stats["topic_id"] = topic_id

        # Per-topic
        if topic_id:
            t_stats = per_topic[topic_id]
            t_stats["answered_q"] += 1
            if is_correct:
                t_stats["correct_q"] += 1
            else:
                t_stats["wrong_q"] += 1

            if token in ("sr", "sw"):
                t_stats["sureshot_q"] += 1
                if token == "sw":
                    t_stats["sureshot_wrong"] += 1
            elif token in ("ar", "aw"):
                t_stats["applied_q"] += 1
                if token == "aw":
                    t_stats["applied_wrong"] += 1
            elif token in ("gr", "gw"):
                t_stats["guesswork_q"] += 1
                if token == "gw":
                    t_stats["guesswork_wrong"] += 1

        # Per-topic × OLT
        if topic_id and olt_id:
            key = (topic_id, olt_id)
            to_stats = per_topic_olt[key]
            to_stats["answered_q"] += 1
            if is_correct:
                to_stats["correct_q"] += 1
            else:
                to_stats["wrong_q"] += 1

            if token in ("sr", "sw"):
                to_stats["sureshot_q"] += 1
                if token == "sw":
                    to_stats["sureshot_wrong"] += 1
            elif token in ("ar", "aw"):
                to_stats["applied_q"] += 1
                if token == "aw":
                    to_stats["applied_wrong"] += 1
            elif token in ("gr", "gw"):
                to_stats["guesswork_q"] += 1
                if token == "gw":
                    to_stats["guesswork_wrong"] += 1

    # Compute UPSC-style net marks (attempt types don't matter here)
    net_marks = (Decimal(correct_q) * MARKS_RIGHT) - (Decimal(wrong_q) * MARKS_WRONG)

    total = {
        "total_q": total_q,
        "answered_q": answered_q,
        "correct_q": correct_q,
        "wrong_q": wrong_q,
        "unattempted_q": unattempted_q,
        "blind_q": blind_q,
        "blind_wrong": blind_wrong,
        "sureshot_q": sureshot_q,
        "applied_q": applied_q,
        "guesswork_q": guesswork_q,
        "sureshot_wrong": sureshot_wrong,
        "applied_wrong": applied_wrong,
        "guesswork_wrong": guesswork_wrong,
        "net_marks": net_marks,
    }

    aggregates = {
        "mode": mode,
        "now": now,
        "user": user,
        "session": session,
        "date": timezone.localdate(now),
        "duration_hours": float(duration_hours),
        "total": total,
        "per_question": per_question,
        "per_topic": per_topic,
        "per_topic_olt": per_topic_olt,
        "per_topic_tokens": per_topic_tokens,  # ✅ NEW for TEST rolling window merge
    }
    return aggregates


def update_session_row(session, agg: dict) -> None:
    """
    Update Test or PracticeSession row from aggregates.

    Notes (v1):
    - Blind is treated as 'na' for the TMI rolling window, BUT we still report
      blind_attempts/blind_wrong on the Test model.
    - build_aggregates() must provide total['blind_q'] and total['blind_wrong'].
    """
    total = agg["total"]
    now = agg["now"]
    mode = agg["mode"]

    # Common fields (both Test and PracticeSession should have these)
    session.total_questions = total["total_q"]
    session.correct_answers = total["correct_q"]
    session.unattempted = total["unattempted_q"]
    session.total_score = total["net_marks"]

    session.sureshot_attempts = total["sureshot_q"]
    session.applied_attempts = total["applied_q"]
    session.guesswork_attempts = total["guesswork_q"]

    session.sureshot_wrong = total["sureshot_wrong"]
    session.applied_wrong = total["applied_wrong"]
    session.guesswork_wrong = total["guesswork_wrong"]

    # Test-only fields (your Test model has blind_* explicitly)
    if isinstance(session, Test) or mode == "test":
        session.blind_attempts = total.get("blind_q", 0)
        session.blind_wrong = total.get("blind_wrong", 0)

    session.status = "completed"
    session.end_time = now
    session.save()


def update_qas(agg: dict) -> None:
    """
    Update QuestionAttemptSummary for TEST mode only.

    Uses:
      agg["per_question"][question_id] = {
          answered_q, correct_q, wrong_q,
          sureshot_q, applied_q, guesswork_q,
          sureshot_wrong, applied_wrong, guesswork_wrong,
          topic_id
      }

    Notes:
    - We only update QAS in TEST mode (as per your design).
    - We set last_attempted to agg["now"] on any question touched in this submit.
    - net_marks is recomputed from cumulative correct/wrong.
    """
    if agg["mode"] != "test":
        return

    user = agg["user"]
    now = agg["now"]
    per_q = agg["per_question"]
    if not per_q:
        return

    question_ids = list(per_q.keys())

    existing = QuestionAttemptSummary.objects.filter(
        user=user,
        question_id__in=question_ids,
    )
    q_map = {obj.question_id: obj for obj in existing}

    to_create = []
    to_update = []

    for qid, s in per_q.items():
        obj = q_map.get(qid)
        if not obj:
            obj = QuestionAttemptSummary(
                user=user,
                question_id=qid,
                topic_id=s.get("topic_id"),
            )
            q_map[qid] = obj
            to_create.append(obj)

        # Increment cumulative counters
        obj.total_attempts += s["answered_q"]
        obj.correct_attempts += s["correct_q"]
        obj.wrong_attempts += s["wrong_q"]

        obj.sureshot_attempts += s["sureshot_q"]
        obj.applied_attempts += s["applied_q"]
        obj.guesswork_attempts += s["guesswork_q"]

        obj.sureshot_wrong += s["sureshot_wrong"]
        obj.applied_wrong += s["applied_wrong"]
        obj.guesswork_wrong += s["guesswork_wrong"]

        # Recompute net marks from cumulative correct/wrong
        obj.net_marks = (
            Decimal(obj.correct_attempts) * MARKS_RIGHT
            - Decimal(obj.wrong_attempts) * MARKS_WRONG
        )

        # Stamp last attempted
        if hasattr(obj, "last_attempted"):
            obj.last_attempted = now

        if obj not in to_create:
            to_update.append(obj)

    if to_create:
        QuestionAttemptSummary.objects.bulk_create(to_create)

    if to_update:
        fields = [
            "total_attempts",
            "correct_attempts",
            "wrong_attempts",
            "sureshot_attempts",
            "applied_attempts",
            "guesswork_attempts",
            "sureshot_wrong",
            "applied_wrong",
            "guesswork_wrong",
            "net_marks",
        ]
        if hasattr(QuestionAttemptSummary, "last_attempted"):
            fields.append("last_attempted")

        QuestionAttemptSummary.objects.bulk_update(to_update, fields)

# Constants for TMI v1
TMI_WINDOW_N = 30
TMI_MIN_ATTEMPTED = 10

ATTEMPTED_TOKENS = {"sr", "sw", "ar", "aw", "gr", "gw"}

TMI_WEIGHTS = {
    "sr": Decimal("1.00"),
    "ar": Decimal("0.90"),
    "gr": Decimal("0.60"),
    "sw": Decimal("-0.45"),
    "aw": Decimal("-0.35"),
    "gw": Decimal("-0.25"),
    "na": Decimal("0.00"),
}


def _compute_tmi_from_window(tokens: list) -> tuple[Decimal | None, int]:
    """
    Compute TMI from a rolling window list of tokens.

    tokens: list like ["na","sr","aw",...]
           (coming from TopicAttemptSummary.last_n_questions_test)

    Rule:
      - Only attempted tokens are counted for the average (sr/sw/ar/aw/gr/gw)
      - If attempted_count < TMI_MIN_ATTEMPTED => TMI is None
      - Else TMI = average(weight(token)) over attempted tokens

    Returns:
      (tmi_decimal_or_none, attempted_count_in_window)
    """
    if not tokens:
        return None, 0

    attempted = [t for t in tokens if t in ATTEMPTED_TOKENS]
    n = len(attempted)

    if n < TMI_MIN_ATTEMPTED:
        return None, n

    score_sum = sum((TMI_WEIGHTS[t] for t in attempted), Decimal("0.00"))
    tmi = score_sum / Decimal(n)
    return tmi, n


def update_tas(agg: dict) -> None:
    """
    Update TopicAttemptSummary (per topic + mode).

    TEST additions:
      - merge per_topic_tokens[topic_id] into TAS.last_n_questions_test (rolling window N=30)
      - update test_questions_seen / total_test_questions using token counts
      - set last_updated explicitly (bulk_* won't auto_now)
    """
    user = agg["user"]
    mode = agg["mode"]
    now = agg["now"]
    per_topic = agg["per_topic"]
    if not per_topic:
        return

    topic_ids = list(per_topic.keys())

    existing = TopicAttemptSummary.objects.filter(
        user=user,
        topic_id__in=topic_ids,
        mode=mode,
    )
    t_map = {obj.topic_id: obj for obj in existing}

    to_create = []
    to_update = []

    per_topic_tokens = agg.get("per_topic_tokens", {})  # only meaningful for test

    for topic_id, s in per_topic.items():
        obj = t_map.get(topic_id)
        if not obj:
            obj = TopicAttemptSummary(
                user=user,
                topic_id=topic_id,
                mode=mode,
            )
            t_map[topic_id] = obj
            to_create.append(obj)

        # ── Core aggregates (attempted only)
        obj.total_attempts += s["answered_q"]
        obj.correct_attempts += s["correct_q"]
        obj.wrong_attempts += s["wrong_q"]

        obj.sureshot_attempts += s["sureshot_q"]
        obj.applied_attempts += s["applied_q"]
        obj.guesswork_attempts += s["guesswork_q"]

        obj.sureshot_wrong += s["sureshot_wrong"]
        obj.applied_wrong += s["applied_wrong"]
        obj.guesswork_wrong += s["guesswork_wrong"]

        # ── Test-only bookkeeping + rolling window
        if mode == "test":
            new_tokens = per_topic_tokens.get(topic_id, [])
            if new_tokens:
                # seen = attempted or left (na included)
                seen_inc = len(new_tokens)
                

                obj.test_questions_seen += seen_inc
                obj.total_test_questions += seen_inc  # keep consistent with your schema (can diverge later if needed)

                # (optional) if you want this aligned with attempts, you already have total_attempts += answered_q

                # rolling window merge
                existing_window = list(obj.last_n_questions_test or [])
                obj.last_n_questions_test = (existing_window + new_tokens)[-TMI_WINDOW_N:]

            # reporting (blind counts) — only if you actually use them in TAS
            obj.blind_attempts += s.get("blind_q", 0)
            obj.blind_wrong += s.get("blind_wrong", 0)

        # net marks from cumulative totals
        obj.net_marks = (
            Decimal(obj.correct_attempts) * MARKS_RIGHT
            - Decimal(obj.wrong_attempts) * MARKS_WRONG
        )

        # bulk_* won't auto_now
        obj.last_updated = now

        if obj not in to_create:
            to_update.append(obj)

    if to_create:
        TopicAttemptSummary.objects.bulk_create(to_create)

    if to_update:
        TopicAttemptSummary.objects.bulk_update(
            to_update,
            [
                "total_test_questions",
                "test_questions_seen",
                "total_attempts",
                "correct_attempts",
                "wrong_attempts",
                "sureshot_attempts",
                "applied_attempts",
                "guesswork_attempts",
                "blind_attempts",
                "sureshot_wrong",
                "applied_wrong",
                "guesswork_wrong",
                "blind_wrong",
                "net_marks",
                "last_n_questions_test",
                "last_updated",
            ],
        )

def update_topic_olt_summary(agg: dict) -> None:
    """
    Update TopicOLTSummary from per_topic_olt aggregates.
    """
    user = agg["user"]
    mode = agg["mode"]
    per_to = agg["per_topic_olt"]
    if not per_to:
        return

    keys = list(per_to.keys())  # (topic_id, olt_id)
    topic_ids = [k[0] for k in keys]
    olt_ids = [k[1] for k in keys]

    existing = TopicOLTSummary.objects.filter(
        user=user,
        topic_id__in=topic_ids,
        olt_id__in=olt_ids,
        mode=mode,
    )
    m = {(obj.topic_id, obj.olt_id): obj for obj in existing}

    to_create = []
    to_update = []

    # Need subject for new rows – we can derive via Topic
    topics = {t.id: t for t in Topic.objects.filter(id__in=topic_ids)}

    for (topic_id, olt_id), s in per_to.items():
        obj = m.get((topic_id, olt_id))
        if not obj:
            topic = topics.get(topic_id)
            obj = TopicOLTSummary(
                user=user,
                subject=topic.section.subject if topic and topic.section else None,
                topic_id=topic_id,
                olt_id=olt_id,
                mode=mode,
            )
            m[(topic_id, olt_id)] = obj
            to_create.append(obj)

        obj.total_attempts += s["answered_q"]
        obj.correct_attempts += s["correct_q"]
        obj.wrong_attempts += s["wrong_q"]

        obj.sureshot_attempts += s["sureshot_q"]
        obj.applied_attempts += s["applied_q"]
        obj.guesswork_attempts += s["guesswork_q"]

        obj.sureshot_wrong += s["sureshot_wrong"]
        obj.applied_wrong += s["applied_wrong"]
        obj.guesswork_wrong += s["guesswork_wrong"]

        obj.net_marks = (
            Decimal(obj.correct_attempts) * MARKS_RIGHT
            - Decimal(obj.wrong_attempts) * MARKS_WRONG
        )
        if obj not in to_create:
            to_update.append(obj)

    if to_create:
        TopicOLTSummary.objects.bulk_create(to_create)

    if to_update:
        TopicOLTSummary.objects.bulk_update(
            to_update,
            [
                "total_attempts",
                "correct_attempts",
                "wrong_attempts",
                "sureshot_attempts",
                "applied_attempts",
                "guesswork_attempts",
                "sureshot_wrong",
                "applied_wrong",
                "guesswork_wrong",
                "net_marks",
                "last_updated",
            ],
        )

def update_topic_status_from_session(agg: dict) -> None:
    """
    Update TopicStatus after a session submit.

    v1 rule:
      - practice mode: compute/update PMI using your existing helper (_compute_and_update_topic_pmi)
      - test mode: update rolling TEST counters (seen/attempted), compute TCI, compute TMI
                 (TMI is computed from TAS.last_n_questions_test AFTER update_tas() has merged tokens)

    Assumptions / requirements:
      - update_tas(agg) has already run in the same transaction, so TAS.last_n_questions_test is updated.
      - TopicAttemptSummary has last_n_questions_test (list of tokens) for mode="test".
      - build_aggregates() provides per_topic[topic_id]["answered_q"] and also per_topic_tokens (so we can
        infer "seen" for this session as len(per_topic_tokens[topic_id]) for test).
      - TMI weights/min-window are handled by _compute_tmi_from_window(window_tokens).
    """
    user = agg["user"]
    mode = agg["mode"]
    per_topic = agg["per_topic"]
    if not per_topic:
        return

    topic_ids = list(per_topic.keys())

    # Preload existing TopicStatus rows for these topics
    statuses = {
        ts.topic_id: ts
        for ts in TopicStatus.objects.filter(user=user, topic_id__in=topic_ids)
    }

    if mode == "practice":
        # PMI is computed from last N completed practice sessions per topic
        for topic_id in topic_ids:
            topic = Topic.objects.get(pk=topic_id)
            _compute_and_update_topic_pmi(user, topic)
        return

    # ─────────────────────────────────────────────
    # TEST MODE
    # ─────────────────────────────────────────────

    # 1) Determine "seen" and "attempted" in this session per topic
    # seen = questions from that topic present in this test (attempted or unattempted/blind)
    per_topic_tokens = agg.get("per_topic_tokens", {})
    seen_by_topic = {tid: len(per_topic_tokens.get(tid, [])) for tid in topic_ids}
    attempted_by_topic = {tid: per_topic[tid]["answered_q"] for tid in topic_ids}

    # 2) Fetch TAS rolling windows (already updated by update_tas)
    tas_rows = TopicAttemptSummary.objects.filter(
        user=user,
        topic_id__in=topic_ids,
        mode="test",
    ).only("topic_id", "last_n_questions_test")

    window_by_topic = {t.topic_id: (t.last_n_questions_test or []) for t in tas_rows}

    # 3) For new TopicStatus rows, we need Topic objects for exam/subject/section
    topics = {t.id: t for t in Topic.objects.select_related("section__subject__exam").filter(id__in=topic_ids)}

    for topic_id in topic_ids:
        topic = topics.get(topic_id)
        if not topic:
            continue

        ts = statuses.get(topic_id)
        if not ts:
            ts = TopicStatus(
                user=user,
                topic=topic,
                section=topic.section,
                subject=topic.section.subject,
                exam=topic.section.subject.exam,
            )
            statuses[topic_id] = ts

        # 4) Update test counters
        seen_inc = seen_by_topic.get(topic_id, 0)
        attempted_inc = attempted_by_topic.get(topic_id, 0)

        ts.test_questions_seen = (ts.test_questions_seen or 0) + seen_inc
        ts.test_questions_attempted = (ts.test_questions_attempted or 0) + attempted_inc

        # 5) Compute TCI (attempted/seen) if seen > 0
        if ts.test_questions_seen and ts.test_questions_seen > 0:
            ts.tci = float(ts.test_questions_attempted / ts.test_questions_seen)
        else:
            ts.tci = None

        # 6) Compute TMI from rolling window tokens (attempted-only, min attempted requirement)
        window = window_by_topic.get(topic_id, [])
        tmi_value, _attempted_in_window = _compute_tmi_from_window(window)  # returns (Decimal|None, int)

        ts.tmi = float(tmi_value) if tmi_value is not None else None

        # (v1) No bucket/band updates here yet
        # (v1) pctwrong_test can be computed later from TAS cumulative counters if you want.

        ts.save()


def update_user_daily_stats(agg: dict) -> None:
    """
    Update UserDailyStats for this user & date.

    Time normalization:
      - expected_time = total_q * 2 minutes
      - if actual_time > expected_time * 1.25:
            use expected_time (convert to hours)
        else:
            use actual_time (hours)
    """
    user = agg["user"]
    date = agg["date"]
    mode = agg["mode"]
    total = agg["total"]

    uds, _ = UserDailyStats.objects.get_or_create(
        user=user,
        date=date,
        defaults={},
    )

    # Totals
    uds.total_attempts += total["answered_q"]
    uds.total_correct += total["correct_q"]
    uds.total_wrong += total["wrong_q"]

    # By attempt-type
    uds.sureshot_attempts += total["sureshot_q"]
    uds.applied_attempts += total["applied_q"]
    uds.guesswork_attempts += total["guesswork_q"]

    uds.sureshot_wrong += total["sureshot_wrong"]
    uds.applied_wrong += total["applied_wrong"]
    uds.guesswork_wrong += total["guesswork_wrong"]

    # ─────────────────────────────────────────────
    # Time normalization
    # ─────────────────────────────────────────────
    actual_hours = float(agg["duration_hours"])

    total_q = int(total.get("total_q", 0))
    expected_minutes = total_q * 2.0
    expected_hours = expected_minutes / 60.0

    # Allow 25% slack above expected
    max_allowed_hours = expected_hours * 1.25

    if expected_hours > 0 and actual_hours > max_allowed_hours:
        hours_to_add = expected_hours
    else:
        hours_to_add = actual_hours

    # Time by mode
    if mode == "practice":
        uds.practice_time += hours_to_add
    else:
        uds.test_time += hours_to_add

    uds.save()

def register_profile_attempts(agg: dict) -> None:
    """
    Bump profile streak counters using register_attempt.
    """
    user = agg["user"]
    attempt_count = agg["total"]["answered_q"]
    if attempt_count and hasattr(user, "profile"):
        user.profile.register_attempt(increment=attempt_count)

def register_subscription_attempts(agg: dict) -> None:
    """
    Optional: count usage against Subscription plan.
    Safe no-op if user has no subscription.
    """
    user = agg["user"]
    attempt_count = agg["total"]["answered_q"]
    sub = getattr(user, "subscription", None)
    if attempt_count and sub:
        # strict=False so it never raises here; you can enforce limits earlier.
        sub.count_attempts(increment=attempt_count, strict=False)